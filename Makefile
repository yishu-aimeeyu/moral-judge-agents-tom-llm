# Workflow checks and reproducible regeneration targets (E7c).
#
# `make check` is the one to run before a figure freeze or a handoff. Every target here is
# read-only with respect to results: nothing re-runs a GPU experiment, and nothing rewrites a
# committed CSV.

PY ?= .venv/bin/python

.PHONY: help check check-prespec check-regen check-headers triage verify-e6b children clean-pyc

help:
	@echo "make check         all workflow checks (prespec history, tags, regeneration, headers)"
	@echo "make check-prespec prespecs are append-only and tagged"
	@echo "make check-regen   committed generated docs match their generators byte-for-byte"
	@echo "make check-headers 'Generated by X at <commit>' headers are not stale"
	@echo "make verify-e6b    E6b geometry + label audits (CPU, no models needed)"
	@echo "make triage        refresh the uncommitted-file worklist"
	@echo "make children      rebuild the OSF child anchor and its comparison figure"
	@echo "make clean-pyc     delete __pycache__ (note: bytecode is tracked in git; see triage)"

check:
	$(PY) code/experiments/70_workflow_checks.py --all

check-prespec:
	$(PY) code/experiments/70_workflow_checks.py --append-only --tags

# The reason this target exists: MENTOR_PACKET.md was hand-edited and then silently overwritten by
# its own generator, losing the edits. This asserts the committed file IS the generator's output.
check-regen:
	$(PY) code/experiments/70_workflow_checks.py --regeneration

check-headers:
	$(PY) code/experiments/70_workflow_checks.py --headers

verify-e6b:
	$(PY) code/experiments/67_e6b_orthogonalized.py --verify-labels
	$(PY) code/experiments/67_e6b_orthogonalized.py --verify-geometry

triage:
	$(PY) code/experiments/68_dirty_triage.py

children:
	$(PY) code/experiments/69_children_ingest.py --build
	$(PY) code/experiments/69_children_ingest.py --build --first-session-only
	$(PY) code/experiments/69_children_ingest.py --plot

clean-pyc:
	find code -name '__pycache__' -type d -prune -exec rm -rf {} +
